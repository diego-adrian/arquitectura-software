{
  "name": "cupo",
  "version": "0.1.0",
  "description": "Cupo: inscripción de materias (proyecto de clase, datos ficticios). Arquitectura de Software, UCB. Cada sesión del módulo mejora este sistema.",
  "author": "Adrian",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "license": "UNLICENSED",
  "scripts": {
    "datos:reiniciar": "node scripts/reiniciar-datos.js",
    "simuladores": "ts-node simuladores/index.ts",
    "start": "node scripts/reiniciar-datos.js --si-falta && nest start",
    "start:dev": "node scripts/reiniciar-datos.js --si-falta && nest start --watch",
    "build": "nest build",
    "test": "jest",
    "test:contrato": "jest --selectProjects contrato",
    "test:problemas": "jest --selectProjects problemas",
    "test:soluciones": "jest --selectProjects soluciones"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "jest": "^30.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "jest": {
    "projects": [
      {
        "displayName": { "name": "contrato", "color": "blue" },
        "moduleFileExtensions": ["js", "json", "ts"],
        "rootDir": ".",
        "testMatch": ["<rootDir>/test/contrato/**/*.spec.ts"],
        "transform": { "^.+\\.ts$": "ts-jest" },
        "testEnvironment": "node"
      },
      {
        "displayName": { "name": "problemas", "color": "red" },
        "moduleFileExtensions": ["js", "json", "ts"],
        "rootDir": ".",
        "testMatch": ["<rootDir>/test/problemas/**/*.spec.ts"],
        "transform": { "^.+\\.ts$": "ts-jest" },
        "testEnvironment": "node"
      },
      {
        "displayName": { "name": "soluciones", "color": "green" },
        "moduleFileExtensions": ["js", "json", "ts"],
        "rootDir": ".",
        "testMatch": ["<rootDir>/test/soluciones/**/*.spec.ts"],
        "transform": { "^.+\\.ts$": "ts-jest" },
        "testEnvironment": "node"
      }
    ]
  }
}
